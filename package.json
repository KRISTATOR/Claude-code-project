{
  "name": "zazemi",
  "productName": "Zázemí",
  "version": "0.3.0",
  "private": true,
  "description": "Zázemí – pracovní prostor organizátorů Chýnického LARPu",
  "author": "Chýnický LARP",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:test": "cross-env ZAZEMI_TEST_BUILD=1 electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dist:win": "electron-vite build && electron-builder --win nsis --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never",
    "test:db": "vitest run tests/db",
    "stack": "node scripts/local-stack/stack.mjs start",
    "stack:reset": "node scripts/local-stack/stack.mjs reset",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@mantine/core": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "@mantine/modals": "^9.7.0",
    "@mantine/notifications": "^9.7.0",
    "@mantine/spotlight": "^9.7.0",
    "@playwright/test": "1.63",
    "@supabase/supabase-js": "^2.117.2",
    "@tabler/icons-react": "^3.49.0",
    "@types/cytoscape": "^3.21.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "cytoscape": "^3.34.3",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "docx-preview": "^0.4.1",
    "docxtemplater": "^3.71.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "i18next": "^26.4.2",
    "markdown-it": "^15.0.2",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "pizzip": "^3.3.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^7.18.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
