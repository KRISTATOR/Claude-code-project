{
  "name": "zazemi",
  "productName": "Zázemí",
  "version": "0.0.1",
  "private": true,
  "description": "Zázemí – pracovní prostor organizátorů Chýnického LARPu",
  "author": "Chýnický LARP",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:test": "cross-env ZAZEMI_TEST_BUILD=1 electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dist:win": "electron-vite build && electron-builder --win nsis --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never",
    "test:db": "vitest run tests/db",
    "stack": "node scripts/local-stack/stack.mjs start",
    "stack:reset": "node scripts/local-stack/stack.mjs reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "electron-updater": "^6.8.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@mantine/core": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "@playwright/test": "1.63",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "i18next": "^26.4.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
